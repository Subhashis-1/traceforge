# Multi-stage Dockerfile for the Trace Forge ingester.

FROM golang:1.25 AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/ingester ./cmd/ingester

FROM alpine:3.21

RUN apk add --no-cache ca-certificates wget

COPY --from=builder /out/ingester /ingester

EXPOSE 4317
EXPOSE 4318

ENTRYPOINT ["/ingester"]
